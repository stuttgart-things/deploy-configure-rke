---
{% if install_containerd %}
container-runtime-endpoint: {{ container_runtime_endpoint }}
{% endif %}
{% if kubeconfig_mode_644 %}
write-kubeconfig-mode: 644
{% endif %}
{% if inventory_hostname not in groups['initial_master_node'] %}
{% for host in groups['initial_master_node'] %}
server: https://{{ hostvars[host]['ansible_default_ipv4']['address'] }}:{{ rke2_node_register_port }}
{% endfor %}{% endif %}
{% if rke2_shared_token is defined %}
token: {{ rke2_shared_token }}
{% endif %}
cni: {{ rke2_cni }}
{% if rke2_tls_sans is defined %}{% for tls_san in rke2_tls_sans.values() %}
tls-san:
  - {{ tls_san }}
{% endfor %}{% endif %}
{% if disable_rke2_components is defined %}
disable:
{% for disablement in disable_rke2_components %}
  - {{ disablement }}
{% endfor %}
{% endif %}
disable-kube-proxy: {{ disableKubeProxy }}
{% if inventory_hostname in groups['workers'] %}
disable-etcd: true
disable-apiserver: true
disable-controller-manager: true
disable-scheduler: true
{% endif %}
{% if inventory_hostname not in groups['workers'] %}
{% set _apiserver_args = rke2_kube_apiserver_args | list %}
{% set _apiserver_mounts = rke2_kube_apiserver_extra_mounts | list %}
{% if rke2_authentication_config | length > 0 %}
{% set _apiserver_args = _apiserver_args + ['authentication-config=' ~ rke2_authentication_config_dir ~ '/' ~ rke2_authentication_config_file] %}
{% set _apiserver_mounts = _apiserver_mounts + [rke2_authentication_config_dir ~ ':' ~ rke2_authentication_config_dir ~ ':ro'] %}
{% endif %}
{% if _apiserver_args | length > 0 %}
kube-apiserver-arg:
{% for arg in _apiserver_args %}
  - {{ arg | to_json }}
{% endfor %}
{% endif %}
{% if _apiserver_mounts | length > 0 %}
kube-apiserver-extra-mount:
{% for mount in _apiserver_mounts %}
  - {{ mount | to_json }}
{% endfor %}
{% endif %}
{% endif %}
